# PostgreSQL connection for the API (and the tests' server; each test class makes its own database on it).
# scripts/test.sh sets this to a local Docker PostgreSQL when it is not set.
ConnectionStrings__App=Host=127.0.0.1;Port=5435;Username=postgres;Password=app
# Optional: the web app's origin for CORS (default http://localhost:3000)
Cors__Origin=http://localhost:3000
# Optional: insert sample rows at startup, and the sample accounts' password
Seed__Demo=false
Seed__Password=
